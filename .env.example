# Resend (https://resend.com) — used by /api/contact.ts to send the contact-form email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions get delivered.
CONTACT_TO_EMAIL=hello@fusionx.tech

# The "from" address Resend sends as. Must be on a domain you've verified with Resend
# (or use Resend's shared onboarding domain, e.g. onboarding@resend.dev, until fusionx.tech is verified).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 measurement ID. Leave unset and no analytics script is loaded at all
# (so local dev and preview deploys don't pollute the property).
# Create a GA4 property at https://analytics.google.com, then Admin → Data streams → Web.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
